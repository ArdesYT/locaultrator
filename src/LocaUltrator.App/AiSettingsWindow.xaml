<Window x:Class="LocaUltrator.App.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini API-kulcsok, kvóták és fordítási beállítások" Width="1080" Height="900" MinWidth="900" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowGradient}" Foreground="{StaticResource TextPrimary}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource WindowGradient}">
        <Grid Margin="28" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="GEMINI API" Style="{StaticResource SectionLabel}" Foreground="#5BE7C4"/>
                <TextBlock Text="Többkulcsos, kvótavédett fordítás" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,4"/>
                <TextBlock Text="Minden engedélyezett kulcs részt vesz a soros körforgásban. Nincs párhuzamos kérésroham; a projektcsoport és az RPM beállítása vezérli a várakozást."
                           Foreground="#8DA5B7" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,20,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="API-KULCSOK ÉS ÁLLAPOTUK" Style="{StaticResource SectionLabel}"/>
                        <ListBox x:Name="KeyList" Height="300" Margin="0,10,0,9" SelectionChanged="OnKeySelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding RuntimeMessage}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Ellipse Width="9" Height="9" Fill="{Binding StatusColor}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                        <StackPanel Grid.Column="1" Margin="3,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding UsageSummary}" Foreground="#7891A4" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontSize="9" FontWeight="Bold" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel>
                            <Button Content="＋ Új" Click="OnAddKey"/>
                            <Button Content="Törlés" Click="OnRemoveKey"/>
                            <Button Content="↑" Click="OnMoveKeyUp" Padding="10,8" ToolTip="Előrébb a körforgásban"/>
                            <Button Content="↓" Click="OnMoveKeyDown" Padding="10,8" Margin="0" ToolTip="Hátrébb a körforgásban"/>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="KIJELÖLT KULCS" Style="{StaticResource SectionLabel}"/>
                            <Border Grid.Column="1" Background="#102C29" BorderBrush="#2B7568" BorderThickness="1" CornerRadius="9" Padding="9,4">
                                <TextBlock x:Name="ActiveBadge" Text="ENGEDÉLYEZVE · KÖRFORGÁSBAN" Foreground="#5BE7C4" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="Kulcs neve" Foreground="#AABCCA" Margin="0,10,0,5"/><TextBox x:Name="KeyNameBox" TextChanged="OnKeyEditorChanged"/>
                        <TextBlock Text="Gemini API-kulcs" Foreground="#AABCCA" Margin="0,10,0,5"/><PasswordBox x:Name="ApiKeyBox" PasswordChanged="OnKeyEditorChanged"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Használati / számlázási szint" Foreground="#AABCCA" Margin="0,0,0,5"/><ComboBox x:Name="UsageTierBox" SelectionChanged="OnUsageTierChanged"/></StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom"><Button Content="Hivatalos AI Studio limitek" Click="OnOpenRateLimits" Margin="0"/><TextBlock Text="A Tier önmagában nem határozza meg a limiteket." Foreground="#718DA1" FontSize="9" Margin="0,5,0,0"/></StackPanel>
                        </Grid>
                        <TextBlock Text="GEMINI 3.7 FLASH · AKTÍV AI STUDIO LIMITEK" Style="{StaticResource SectionLabel}" Foreground="#45D8F2" Margin="0,11,0,0"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="RPM" Foreground="#AABCCA" Margin="0,0,0,5"/><TextBox x:Name="RequestsPerMinuteBox" TextChanged="OnKeyEditorChanged" ToolTip="Requests per minute a gemini-3.7-flash modellhez."/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="TPM (bemenet)" Foreground="#AABCCA" Margin="0,0,0,5"/><TextBox x:Name="TokensPerMinuteBox" TextChanged="OnKeyEditorChanged" ToolTip="Input tokens per minute a gemini-3.7-flash modellhez."/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="RPD" Foreground="#AABCCA" Margin="0,0,0,5"/><TextBox x:Name="RequestsPerDayBox" TextChanged="OnKeyEditorChanged" ToolTip="Requests per day; a Google ezt csendes-óceáni idő szerint éjfélkor nullázza."/></StackPanel>
                        </Grid>
                        <TextBlock Text="GEMINI 3.1 PRO PREVIEW · AKTÍV AI STUDIO LIMITEK" Style="{StaticResource SectionLabel}" Foreground="#B59CFF" Margin="0,11,0,0"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="RPM" Foreground="#AABCCA" Margin="0,0,0,5"/><TextBox x:Name="ProRequestsPerMinuteBox" TextChanged="OnKeyEditorChanged" ToolTip="A gemini-3.1-pro-preview aktív RPM-je; Free Tieren nem használható."/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="TPM (bemenet)" Foreground="#AABCCA" Margin="0,0,0,5"/><TextBox x:Name="ProTokensPerMinuteBox" TextChanged="OnKeyEditorChanged" ToolTip="Input tokens per minute a gemini-3.1-pro-preview modellhez."/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="RPD" Foreground="#AABCCA" Margin="0,0,0,5"/><TextBox x:Name="ProRequestsPerDayBox" TextChanged="OnKeyEditorChanged" ToolTip="Requests per day a gemini-3.1-pro-preview modellhez."/></StackPanel>
                        </Grid>
                        <TextBlock Text="Google Cloud-projekt / kvótacsoport" Foreground="#AABCCA" Margin="0,10,0,5"/>
                        <TextBox x:Name="QuotaGroupBox" TextChanged="OnKeyEditorChanged" ToolTip="Azonos Google Cloud-projekthez tartozó kulcsoknál pontosan ugyanazt a csoportnevet add meg, mert a Google projektenként számolja a kvótát."/>
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <CheckBox x:Name="KeyEnabledBox" Content="Kulcs engedélyezve és részt vesz a körforgásban" VerticalAlignment="Center" Checked="OnKeyEditorChanged" Unchecked="OnKeyEditorChanged"/>
                            <Button x:Name="TestSelectedButton" Grid.Column="1" Content="Kapcsolat próbája" Click="OnTest" Style="{StaticResource SuccessButton}" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Text="Free: kizárólag Gemini 3.7 Flash. Tier 1–3: dinamikus 3.7 Flash ↔ 3.1 Pro váltás. A limitek modellenként és projektenként változnak; 429 esetén csak az érintett projekt+modell hűl le."
                                   Foreground="#718DA1" FontSize="9" TextWrapping="Wrap" Margin="0,9,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="KÉZZEL IS SZERKESZTHETŐ KULCSFÁJL · AUTOMATIKUS MENTÉS" Style="{StaticResource SectionLabel}" Foreground="#5BE7C4"/>
                            <TextBlock x:Name="KeyFilePathText" Foreground="#8DA5B7" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip="A fájl olvasható formában tartalmazza a titkos kulcsokat. Ne oszd meg és ne töltsd fel nyilvános helyre."/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Kulcsfájl megnyitása" Click="OnOpenKeyFile" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="Újratöltés fájlból" Click="OnReloadKeyFile" Margin="8,0,0,0"/>
                        <Button x:Name="TestAllButton" Grid.Column="3" Content="Összes kulcs tesztelése" Click="OnTestAll" Margin="8,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Elsődleges modell" VerticalAlignment="Center"/><ComboBox x:Name="ModelBox" Grid.Column="1" ToolTip="Csak Gemini 3.7 Flash és Gemini 3.1 Pro használható. Fizetős Tieren a program terhelés vagy modellkvóta esetén automatikusan a másikra vált."/>
                    <TextBlock Grid.Column="3" Text="Kötegméret" VerticalAlignment="Center"/><TextBox x:Name="BatchSizeBox" Grid.Column="4"/>
                    <TextBlock Grid.Row="1" Text="Mintavétel" VerticalAlignment="Center" Margin="0,12,0,0"/><Border Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Background="#0B1721" BorderBrush="#20384A" BorderThickness="1" CornerRadius="8" Padding="11"><TextBlock Text="Hivatalos modell-alapérték · temperature nincs küldve" Foreground="#8DA5B7"/></Border>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Gondolkodási szint" VerticalAlignment="Center" Margin="0,12,0,0"/><ComboBox x:Name="ThinkingLevelBox" Grid.Row="1" Grid.Column="4" Margin="0,12,0,0" ToolTip="Alapérték: high; mindkét engedélyezett modell támogatja."/>
                </Grid>
            </Border>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,7,0">
                    <StackPanel><TextBlock Text="STÍLUSUTASÍTÁS" Style="{StaticResource SectionLabel}"/><TextBox x:Name="StyleGuideBox" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="7,0,0,0">
                    <StackPanel><TextBlock Text="SZÓJEGYZÉK" Style="{StaticResource SectionLabel}"/><TextBox x:Name="GlossaryBox" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" ToolTip="Példa: Save = Mentés"/></StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="#0B1721" BorderBrush="#20384A" BorderThickness="1" CornerRadius="12" Padding="12">
                    <TextBlock x:Name="StatusText" Text="A kulcsok még nincsenek tesztelve." Foreground="#F3F8FC" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Mégse" Click="OnCancel"/>
                    <Button x:Name="SaveButton" Content="Kulcsok és beállítások mentése" Click="OnSave" Style="{StaticResource PrimaryButton}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
