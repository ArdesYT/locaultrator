<Window x:Class="LocaUltrator.App.GameIntegrationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Játékszöveg kinyerése és visszacsomagolása" Width="1050" Height="740" MinWidth="860" MinHeight="600" WindowStartupLocation="CenterOwner">
    <Grid Background="#0B1020" Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Játék felismerése és adapteres feldolgozás" FontSize="24" FontWeight="Bold"/><TextBlock Text="Az eredeti játékfájlt a LocaUltrator nem írja felül. Az adapterek külön munkaterületen, naplóval és hash-ellenőrzéssel futnak." Foreground="#22D3EE" TextWrapping="Wrap" Margin="0,5,0,14"/></StackPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="GameRootBox" ToolTip="A játék telepítési mappája"/><Button Grid.Column="1" Content="Mappa kiválasztása" Click="OnBrowseGame" Margin="8,0,0,0"/><Button Grid.Column="2" Content="Felismerés" Click="OnDetect" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Background="#121A2B" BorderBrush="#273653" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,7,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="DetectionTitle" Text="Motor: még nincs felismerve" FontSize="17" FontWeight="Bold"/>
                    <TextBlock x:Name="DetectionDetail" Grid.Row="1" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,5,0,10"/>
                    <ListBox Grid.Row="2" x:Name="LooseFilesList" SelectionMode="Extended" Background="#0E1628" BorderBrush="#273653" Foreground="#F1F5F9"/>
                    <StackPanel Grid.Row="3" Margin="0,10,0,0"><Button Content="Teljes játékmappa használata a projektben" Click="OnImport" Background="#12603E" HorizontalAlignment="Stretch"/><TextBlock x:Name="FileCountText" Foreground="#94A3B8" TextWrapping="Wrap" Margin="3,7,0,0"/></StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="#121A2B" BorderBrush="#273653" BorderThickness="1" CornerRadius="12" Padding="14" Margin="7,0,0,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Külső ki-/visszacsomagoló adapter" FontSize="17" FontWeight="Bold"/>
                    <ComboBox Grid.Row="1" x:Name="AdapterBox" DisplayMemberPath="Name" SelectionChanged="OnAdapterChanged" Margin="0,10,0,0"/>
                    <ComboBox Grid.Row="2" x:Name="OperationBox" DisplayMemberPath="DisplayName" Margin="0,8,0,0"/>
                    <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TranslatedInputBox" ToolTip="Visszacsomagolásnál a fordított bemenet; kinyerésnél üres maradhat"/><Button Grid.Column="1" Content="Bemenet" Click="OnBrowseInput" Margin="8,0,0,0"/></Grid>
                    <TextBox Grid.Row="4" x:Name="AdapterLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>
                    <Button Grid.Row="5" Content="Adapter futtatása elkülönített munkaterületen" Click="OnRunAdapter" Margin="0,10,0,0" Background="#5B3A12"/>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="A teljes mappa projektként akkor is megadható, ha a szöveg archívumban van. A visszacsomagolás csak motorhoz illő, ellenőrzött .locatool.json adapterrel indul." Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </Grid>
</Window>
