<Window x:Class="LocaUltrator.App.TokenProfilePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI-tokenprofil ellenőrzése" Width="920" Height="680"
        MinWidth="720" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="{StaticResource WindowGradient}" Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="BIZTONSÁGI ELŐNÉZET" Style="{StaticResource SectionLabel}" Foreground="#5BE7C4"/>
            <TextBlock Text="Projekt-tokenprofil aktiválás előtt" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,4"/>
            <TextBlock x:Name="Summary" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="10">
            <TextBox x:Name="Details" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Csak a helyi ellenőrzésen átment, valódi projekttalálatok lesznek maszkolva."
                       Foreground="{StaticResource Warning}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Elutasítás" IsCancel="True"/>
                <Button Content="Profil aktiválása" Style="{StaticResource PrimaryButton}" Click="Activate" Margin="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
