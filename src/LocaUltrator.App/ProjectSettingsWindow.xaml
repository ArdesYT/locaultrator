<Window x:Class="LocaUltrator.App.ProjectSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beállítások · csomagméret" Width="920" Height="790" MinWidth="780" MinHeight="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="SettingsTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#8DA5B7"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabSurface" Background="#0D1823" BorderBrush="#294459" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#2B2451"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="#7666DD"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#5A7690"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SettingsTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TabPanel IsItemsHost="True" Background="Transparent" Margin="0,0,0,12"/>
                    <Border Grid.Row="1" Background="#D90D1823" BorderBrush="#294459" BorderThickness="1" CornerRadius="16" Padding="20">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </Border>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowGradient}">
        <Ellipse Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-390,-270,0" IsHitTestVisible="False">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#2B5C46D8" Offset="0"/><GradientStop Color="#005C46D8" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>
        <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="PROJEKT VEZÉRLŐPULT" Style="{StaticResource SectionLabel}" Foreground="#5BE7C4"/><TextBlock Text="Beállítások" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,2"/><TextBlock Text="A csomagméret és a fordítási szabályok ezzel a projekttel együtt mentődnek." Foreground="#8DA5B7"/></StackPanel>
                <Border Grid.Column="1" Background="#17152B" BorderBrush="#514391" BorderThickness="1" CornerRadius="13" Padding="14,9" VerticalAlignment="Center"><TextBlock Text="⚙  PROJEKTSPECIFIKUS" Foreground="#B8AFFF" FontWeight="Bold" FontSize="10"/></Border>
            </Grid>

            <TabControl Grid.Row="1" Style="{StaticResource SettingsTabs}">
                <TabItem Header="Vágólap és csomagméret" Style="{StaticResource SettingsTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <Border Background="#151630" BorderBrush="#5A4CC2" BorderThickness="1" CornerRadius="14" Padding="17" Margin="0,0,0,14">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="FORDÍTÁSI CSOMAG KORLÁTJA" Foreground="#9C8BFF" FontWeight="Bold" FontSize="10"/><TextBlock Text="Te döntöd el, mennyi szöveg kerüljön egyszerre a vágólapra." FontSize="16" FontWeight="SemiBold" Margin="0,5,0,2"/><TextBlock Text="Egyszerre csak a kiválasztott sor- vagy karakterkorlát érvényesül." Foreground="#8DA5B7" FontSize="10"/></StackPanel>
                                <TextBlock Grid.Column="1" Text="TOKENVÉDETT" Foreground="#5BE7C4" FontWeight="Bold" FontSize="9" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GlassCard}" Padding="17"><StackPanel>
                                <TextBlock Text="MÉRETHATÁR" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="Számítás módja" Foreground="#AABCCA" Margin="0,12,0,5"/><ComboBox x:Name="LimitMode" SelectionChanged="LimitModeChanged"/>
                                <TextBlock Text="Sor alapú csomagméret" Foreground="#AABCCA" Margin="0,12,0,5"/><TextBox x:Name="MaximumItems" ToolTip="1 és 5000 közötti érték"/>
                                <TextBlock Text="Karakter alapú csomagméret" Foreground="#AABCCA" Margin="0,12,0,5"/><TextBox x:Name="MaximumCharacters" ToolTip="1000 és 1 000 000 között; a teljes vágólaptartalomra vonatkozik"/>
                                <TextBlock Text="Az inaktív mezőt a program halványítja; annak értékét csak tartalékként őrzi meg." Foreground="#647D90" FontSize="9" TextWrapping="Wrap" Margin="0,9,0,0"/>
                            </StackPanel></Border>

                            <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="17"><StackPanel>
                                <TextBlock Text="PÁRHUZAMOS MUNKA" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="Egyszerre várakozó csomagok" Foreground="#AABCCA" Margin="0,12,0,5"/><TextBox x:Name="MaximumPendingBatches" ToolTip="1 és 20 közötti érték"/>
                                <TextBlock Text="Csomagmásoló gyorsbillentyű" Foreground="#AABCCA" Margin="0,12,0,5"/><ComboBox x:Name="ClipboardHotkey"/>
                                <CheckBox x:Name="GlobalClipboardHotkey" Content="Tálcára kicsinyítve is működjön" Margin="0,14,0,7"/>
                                <CheckBox x:Name="AutoProcessResponses" Content="AI-válasz automatikus feldolgozása" Margin="0,0,0,7"/>
                                <CheckBox x:Name="ShowStatusHud" Content="Felugró állapotértesítések" Margin="0,0,0,9"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><TextBlock Text="Értesítés ideje (mp)" VerticalAlignment="Center" Foreground="#AABCCA"/><TextBox x:Name="StatusHudSeconds" Grid.Column="1" ToolTip="1 és 60 másodperc között"/></Grid>
                            </StackPanel></Border>
                        </Grid>
                    </StackPanel></ScrollViewer>
                </TabItem>

                <TabItem Header="Fordítás és export" Style="{StaticResource SettingsTab}">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GlassCard}" Padding="17"><StackPanel><TextBlock Text="FORDÍTÁS" Style="{StaticResource SectionLabel}"/><TextBlock Text="A fordítás nyelve" Foreground="#AABCCA" Margin="0,12,0,5"/><TextBox x:Name="TargetLanguage"/><TextBlock Text="API / vágólap munkamód" Foreground="#AABCCA" Margin="0,12,0,5"/><ComboBox x:Name="TranslationMode" ToolTip="Automatikus módban API-hiba vagy kulcshiány esetén vágólapos csomag készül."/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="17"><StackPanel><TextBlock Text="KARAKTERKÉSZLET" Style="{StaticResource SectionLabel}"/><TextBlock Text="Exportált ő/ű formája" Foreground="#AABCCA" Margin="0,12,0,5"/><ComboBox x:Name="ExportAccentMode" ToolTip="Normál magyar ő/ű, vagy régi játékokhoz kalapos ô/û karakterek"/></StackPanel></Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="A FORDÍTÓ AI-NAK KÜLDÖTT PROJEKTUTASÍTÁS" Style="{StaticResource SectionLabel}" Margin="2,18,0,8"/>
                        <TextBox x:Name="Instruction" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="260"/>
                    </Grid>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="2" Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="A Mentés azonnal frissíti a vágólapfigyelést és a globális gyorsbillentyűt." Foreground="#647D90" FontSize="9" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Mégse" IsCancel="True"/><Button Content="Beállítások mentése" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save"/></StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
