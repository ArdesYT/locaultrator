<Window x:Class="LocaUltrator.App.StatusHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocaUltrator értesítés" Width="620" Height="205"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Border x:Name="Surface" CornerRadius="18" BorderBrush="#66FFFFFF" BorderThickness="2" Padding="22,17">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.55"/></Border.Effect>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Width="72" Height="72" CornerRadius="36" Background="#3B1D78" BorderBrush="#AAFFFFFF" BorderThickness="2" VerticalAlignment="Top">
                <Grid><Ellipse Width="40" Height="48" Fill="#D8B4FE"/><Ellipse Width="7" Height="9" Fill="#111827" Margin="-14,-7,0,0"/><Ellipse Width="7" Height="9" Fill="#111827" Margin="14,-7,0,0"/><Path Data="M 0 0 Q 10 8 20 0" Stroke="#111827" StrokeThickness="3" Width="20" Height="8" Stretch="Fill" Margin="0,23,0,0"/></Grid>
            </Border>
            <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,7,0,13" FontSize="13" Foreground="White"
                       TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="HÁTRALÉVŐ SOR" Foreground="#EFFFFFFF" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="RemainingText" Foreground="White" FontSize="23" FontWeight="Bold"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="VÁLASZRA VÁR" Foreground="#EFFFFFFF" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="WaitingText" Foreground="White" FontSize="23" FontWeight="Bold"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="AKTÍV CSOMAG" Foreground="#EFFFFFFF" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="PackagesText" Foreground="White" FontSize="23" FontWeight="Bold"/></StackPanel>
            </Grid></Grid>
        </Grid>
    </Border>
</Window>
