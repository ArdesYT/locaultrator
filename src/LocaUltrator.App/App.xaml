<Application x:Class="LocaUltrator.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <Color x:Key="BgColor">#071019</Color>
        <Color x:Key="SurfaceColor">#0D1823</Color>
        <Color x:Key="RaisedColor">#122231</Color>
        <Color x:Key="BorderColor">#20384A</Color>
        <SolidColorBrush x:Key="AppBackground" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="PanelRaised" Color="{StaticResource RaisedColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F8FC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8DA5B7"/>
        <SolidColorBrush x:Key="Accent" Color="#7C5CFC"/>
        <SolidColorBrush x:Key="AccentHover" Color="#947DFF"/>
        <SolidColorBrush x:Key="Cyan" Color="#45D8F2"/>
        <SolidColorBrush x:Key="Success" Color="#5BE7C4"/>
        <SolidColorBrush x:Key="Warning" Color="#F6C85F"/>
        <SolidColorBrush x:Key="Danger" Color="#FB7185"/>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7555F6" Offset="0"/><GradientStop Color="#4A9AEF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#08121D" Offset="0"/><GradientStop Color="#071019" Offset="0.55"/><GradientStop Color="#0D0B18" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource WindowGradient}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="Icon" Value="pack://application:,,,/LocaUltrator;component/Assets/LocaUltrator.ico"/>
            <EventSetter Event="Loaded" Handler="OnWindowLoaded"/>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/></Style>
        <Style TargetType="ScrollViewer"><Setter Property="Background" Value="Transparent"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#101E2B"/><Setter Property="Foreground" Value="#F3F8FC"/><Setter Property="BorderBrush" Value="#41627A"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,8"/><Setter Property="MaxWidth" Value="430"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="11"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#08131D"/><Setter Property="Foreground" Value="#F3F8FC"/><Setter Property="BorderBrush" Value="#294459"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
                <Border x:Name="ListSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="3">
                    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ListSurface" Property="Opacity" Value="0.68"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F3F8FC"/><Setter Property="Padding" Value="9,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#183044"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#44368D"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemSurface" Property="Opacity" Value="0.65"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0A151F"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#294459"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,8"/>
            <Setter Property="CaretBrush" Value="#5BE7C4"/><Setter Property="SelectionBrush" Value="#665C7CFA"/>
        </Style>
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#D90D1823"/><Setter Property="BorderBrush" Value="#283E50"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#688296"/><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="LivePulseDot" TargetType="Ellipse">
            <Setter Property="Opacity" Value="0.45"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.85"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EEF7FC"/><Setter Property="Background" Value="#142535"/><Setter Property="BorderBrush" Value="#294459"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1B3347"/><Setter TargetName="Surface" Property="BorderBrush" Value="#54718A"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Cyan}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.34"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="BorderBrush" Value="#A58FFF"/><Setter Property="Padding" Value="17,10"/></Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#123E38"/><Setter Property="BorderBrush" Value="#287F6D"/></Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,0,4"/></Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0A151F"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderBrush" Value="#294459"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#5BE7C4"/><Setter Property="Padding" Value="11,8"/><Setter Property="SelectionBrush" Value="#665C7CFA"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="TextSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextSurface" Property="BorderBrush" Value="#5BE7C4"/></Trigger><Trigger Property="IsReadOnly" Value="True"><Setter TargetName="TextSurface" Property="Background" Value="#08121A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="TextSurface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="11"/><Setter Property="Height" Value="Auto"/><Setter Property="Background" Value="#08121A"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Border x:Name="ScrollRoot" Background="{TemplateBinding Background}" CornerRadius="6" Padding="2">
                    <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton x:Name="DecreaseButton" Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollPageButton}"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbSurface" Background="#466176" CornerRadius="5"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#6B879B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton x:Name="IncreaseButton" Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollPageButton}"/></Track.IncreaseRepeatButton>
                    </Track>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="11"/></Trigger></Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0A151F"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderBrush" Value="#294459"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,6"/><Setter Property="MaxDropDownHeight" Value="340"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
                <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                    <Border Background="#0A151F" BorderBrush="#294459" BorderThickness="1" CornerRadius="9"><Grid><ContentPresenter Margin="11,7,35,7" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"/><Path Data="M 0 0 L 5 5 L 10 0 Z" Fill="#8DA5B7" Width="10" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Grid></Border>
                </ControlTemplate></ToggleButton.Template></ToggleButton>
                <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#101E2B" BorderBrush="#36556C" BorderThickness="1" CornerRadius="9" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="4"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></Popup>
            </Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F3F8FC"/><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#20384A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#6047C5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#10202E"/><Setter Property="Foreground" Value="#9CB2C2"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="12,11"/><Setter Property="BorderBrush" Value="#20384A"/><Setter Property="BorderThickness" Value="0,0,1,1"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="BorderBrush" Value="#182C3B"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Padding" Value="11,8"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="TextBlock.TextWrapping" Value="Wrap"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2B2C57"/></Trigger></Style.Triggers></Style>
        <Style TargetType="ProgressBar"><Setter Property="Height" Value="8"/><Setter Property="Background" Value="#0A151F"/><Setter Property="Foreground" Value="#5BE7C4"/><Setter Property="BorderThickness" Value="0"/></Style>
    </Application.Resources>
</Application>
