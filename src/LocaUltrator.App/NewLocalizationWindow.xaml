<Window x:Class="LocaUltrator.App.NewLocalizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Új lokalizáció" Width="760" Height="445" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="{StaticResource WindowGradient}" Margin="0">
        <Border Margin="18" Style="{StaticResource GlassCard}" Padding="22" BorderBrush="#514391">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="MIBŐL INDULJON A LOKALIZÁCIÓ?" Style="{StaticResource SectionLabel}" Foreground="#9C8BFF"/><TextBlock Text="Teljes játékot és külön forrásfájlokat is fogad" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,5"/><TextBlock Text="A játékmappánál motorfelismerés, archívumleltár és biztonságos importálási munkafolyamat is készül." Foreground="#8DA5B7" TextWrapping="Wrap"/></StackPanel>
                <Grid Grid.Row="1" Margin="0,22,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="13"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Click="OnGameFolder" Padding="18" Background="#162A3A" BorderBrush="#2D607A" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <StackPanel><TextBlock Text="⬡" FontSize="31" Foreground="#45D8F2"/><TextBlock Text="Teljes játék- vagy kicsomagolt mappa" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,12,0,7"/><TextBlock Text="Motorfelismerés, fájlleltár és közvetlenül olvasható lokalizációs fájlok biztonságos importja." Foreground="#91A9B9" TextWrapping="Wrap" LineHeight="18"/></StackPanel>
                    </Button>
                    <Button Grid.Column="2" Click="OnFiles" Padding="18" Background="#17263A" BorderBrush="#3A5175" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <StackPanel><TextBlock Text="≡" FontSize="31" Foreground="#9C8BFF"/><TextBlock Text="Külön lokalizációs fájlok" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,12,0,7"/><TextBlock Text="TXT, JSONL, CSV, TSV, PO, JSON, XML, INI, LANG és más szöveges források kézi kiválasztása." Foreground="#91A9B9" TextWrapping="Wrap" LineHeight="18"/></StackPanel>
                    </Button>
                </Grid>
                <Button Grid.Row="2" Content="Mégse" HorizontalAlignment="Right" Click="OnCancel"/>
            </Grid>
        </Border>
    </Grid>
</Window>
