<Window x:Class="LocaUltrator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocaUltrator.App"
        Title="LocaUltrator 0.8.7 · Gemini + vágólap fordító" Width="1500" Height="900" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <local:StatusBrushConverter x:Key="StatusBrush"/>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource GlassCard}"><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Padding" Value="15,13"/></Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
    </Window.InputBindings>

    <Grid Background="{StaticResource WindowGradient}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Ellipse Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-500,-300,0" IsHitTestVisible="False">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#243F92FF" Offset="0"/><GradientStop Color="#003F92FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>

        <Border Background="#E808121D" BorderBrush="#20384A" BorderThickness="0,0,1,0">
            <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="#111F2C" BorderBrush="#2A4559" BorderThickness="1" CornerRadius="17" Padding="13" Margin="0,0,0,16">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="13" Background="#17152B" ClipToBounds="True"><Image Source="pack://application:,,,/LocaUltrator;component/Assets/LocaUltrator.png" Stretch="Uniform" Margin="4"/></Border>
                        <StackPanel Grid.Column="1" Margin="11,2,0,0"><TextBlock Text="LOCAULTRATOR" FontWeight="Bold" FontSize="14"/><TextBlock Text="NATÍV WINDOWS · 0.8.7" Foreground="#5BE7C4" FontSize="9" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="PROJEKT" Style="{StaticResource SectionLabel}" Margin="8,2,0,7"/>
                        <Button Style="{StaticResource NavButton}" Content="＋   Új lokalizáció" Command="{Binding NewProjectCommand}"/>
                        <Button Style="{StaticResource NavButton}" Content="↗   Projekt megnyitása" Command="{Binding OpenProjectCommand}"/>
                        <Button Style="{StaticResource NavButton}" Content="↻   Forrás frissítése" Command="{Binding ImportUpdateCommand}"/>
                        <Button Style="{StaticResource NavButton}" Content="▣   Projekt mentése" Command="{Binding SaveCommand}"/>

                        <TextBlock Text="FORDÍTÁSI MÓD" Style="{StaticResource SectionLabel}" Margin="8,18,0,7"/>
                        <ComboBox ItemsSource="{Binding TranslationModes}" SelectedItem="{Binding SelectedTranslationMode}" Margin="0,0,0,7"
                                  ToolTip="Automatikus módban az API hibája vagy kulcshiány esetén a program vágólapos csomagot készít."/>
                        <TextBlock Text="{Binding TransportStatusLabel}" Foreground="#7590A3" FontSize="9" TextWrapping="Wrap" Margin="7,0,5,8"/>
                        <Button Content="{Binding PrimaryTranslationLabel}" Command="{Binding TranslateCommand}" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource NavButton}" Content="⧉   Következő csomag másolása" Command="{Binding CopyBatchCommand}"/>
                        <Button Style="{StaticResource NavButton}" Content="↻   Várakozó csomag újramásolása" Command="{Binding RecopyBatchCommand}"/>
                        <Button Style="{StaticResource NavButton}" Content="✓   Vágólapválasz feldolgozása" Command="{Binding ProcessResponseCommand}"/>
                        <Button Style="{StaticResource NavButton}" Content="×   Várakozó csomag visszaállítása" Command="{Binding CancelBatchCommand}"/>

                        <TextBlock Text="GEMINI API" Style="{StaticResource SectionLabel}" Margin="8,18,0,7"/>
                        <Button Style="{StaticResource NavButton}" Content="⚡   Gemini API beállítások" Click="OnOpenAiSettings"/>
                        <Button Style="{StaticResource NavButton}" Content="◉   Minőségellenőrzés" Click="OnRunQuality"/>

                        <TextBlock Text="TOKENVÉDELEM" Style="{StaticResource SectionLabel}" Margin="8,18,0,7"/>
                        <Button Style="{StaticResource NavButton}" Content="1.   Prompt + TXT az AI-nak" Command="{Binding TokenPromptCommand}"
                                ToolTip="A beépített promptot kitölti a projekt valódi tokenjelöltjeivel, vágólapra másolja és a TXT-pillanatképek mellé menti."/>
                        <Button Style="{StaticResource NavButton}" Content="2.   AI JSON-profil betöltése" Command="{Binding ProcessTokenProfileCommand}"
                                ToolTip="A vágólapon lévő AI-tokenprofilt helyben ellenőrzi, előnézetet mutat, majd aktiválja."/>

                        <TextBlock Text="MŰHELY" Style="{StaticResource SectionLabel}" Margin="8,18,0,7"/>
                        <Button Style="{StaticResource NavButton}" Content="⬡   Játékfájl-műhely" Click="OnOpenGameIntegration"/>
                        <Button Style="{StaticResource NavButton}" Content="⚙   Projektbeállítások" Command="{Binding ProjectSettingsCommand}"/>
                        <Button Style="{StaticResource NavButton}" Content="◇   Kijelölt sor kihagyása" Command="{Binding ToggleSkipCommand}"/>
                        <Button Style="{StaticResource NavButton}" Content="⇩   Biztonságos export" Command="{Binding ExportCommand}" Background="#163B35" BorderBrush="#286C5E"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <Border Background="#0B1721" BorderBrush="#20384A" BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,0,0,8">
                        <StackPanel><Grid><TextBlock Text="PROJEKT HALADÁSA" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding ProgressLabel, Mode=OneWay}" Foreground="#5BE7C4" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right"/></Grid><ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Margin="0,10,0,0"/></StackPanel>
                    </Border>
                    <Button Style="{StaticResource NavButton}" Content="?   Gyors használati útmutató" Command="{Binding HelpCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24,20,24,15"><Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="105"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
            <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="LOKALIZÁCIÓS VEZÉRLŐKÖZPONT" Style="{StaticResource SectionLabel}" Foreground="#5BE7C4"/><TextBlock Text="{Binding ProjectName}" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,2"/><TextBlock Text="{Binding ProjectPath}" Foreground="#7590A3" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#102C29" BorderBrush="#2B7568" BorderThickness="1" CornerRadius="12" Padding="13,8" Margin="0,0,9,0"><StackPanel><TextBlock Text="GEMINI API" Foreground="#5BE7C4" FontWeight="Bold" FontSize="9"/><TextBlock Text="{Binding GeminiStatusLabel}" Foreground="#A6C7C0" FontSize="9" Margin="0,3,0,0"/></StackPanel></Border>
                    <Border Background="#111F2C" BorderBrush="#294459" BorderThickness="1" CornerRadius="12" Padding="13,8"><StackPanel><TextBlock Text="{Binding TokenProfileLabel}" Foreground="#45D8F2" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="{Binding SourceVersionLabel}" Foreground="#7590A3" FontSize="9" Margin="0,2,0,0"/></StackPanel></Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="FORDÍTANDÓ" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding PendingCount}" Foreground="#F6C85F" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="FOLYAMATBAN" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding WaitingCount}" Foreground="#45D8F2" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="KÉSZ" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding CompletedCount}" Foreground="#5BE7C4" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Grid.Column="3" Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="VIZSGÁLANDÓ" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding ReviewCount}" Foreground="#FB7185" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource GlassCard}"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="TELJES HALADÁS" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding ProgressLabel, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#5BE7C4" FontWeight="Bold"/></Grid><ProgressBar Grid.Row="1" Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Margin="0,14,0,6"/><TextBlock Grid.Row="2" Text="Export előtt determinisztikus ellenőrzés" Foreground="#688296" FontSize="9"/></Grid></Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="200"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Keresés a forrásban, fordításban, azonosítóban és kontextusban"/>
                <ComboBox Grid.Column="1" Margin="9,0,0,0" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}"/>
                <Button Grid.Column="2" Content="{Binding PrimaryTranslationLabel}" Command="{Binding TranslateCommand}" Style="{StaticResource PrimaryButton}" Margin="9,0,0,0"/>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource GlassCard}" Padding="0" ClipToBounds="True" Margin="0,0,0,11">
                <DataGrid ItemsSource="{Binding UnitsView}" SelectedItem="{Binding SelectedUnit}" AutoGenerateColumns="False" Background="Transparent" RowBackground="#09151F" AlternatingRowBackground="#0C1924" HeadersVisibility="Column" GridLinesVisibility="All" BorderThickness="0" SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" RowHeaderWidth="0" CanUserAddRows="False" FontSize="12" MinRowHeight="40" RowEditEnding="OnRowEditEnding">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ÁLLAPOT" Width="116" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" FontWeight="SemiBold" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="AZONOSÍTÓ" Binding="{Binding Id}" Width="170" IsReadOnly="True"/>
                        <DataGridTextColumn Header="VÉDETT FORRÁS" Binding="{Binding SourceDisplay}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="MAGYAR FORDÍTÁS" Binding="{Binding TranslationMasked, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="KONTEXTUS" Binding="{Binding ContextDisplay}" Width="210" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Row="4" Background="#B9071018" BorderBrush="#1C3445" BorderThickness="1" CornerRadius="13" Padding="11">
                <DockPanel><TextBlock DockPanel.Dock="Top" Text="ESEMÉNYNAPLÓ" Style="{StaticResource SectionLabel}" Margin="3,0,0,5"/><ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0" Foreground="#8DDCCB" FontFamily="Cascadia Mono, Consolas" FontSize="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></DockPanel>
            </Border>
            <Grid Grid.Row="5" Margin="2,8,2,0"><TextBlock Text="{Binding TransportStatusLabel}" Foreground="#688296" FontSize="9"/><TextBlock Text="0.8.7 · win-x64" Foreground="#688296" FontSize="9" HorizontalAlignment="Right"/></Grid>

            <Border Grid.Row="0" Grid.RowSpan="6" Background="#F2071019" CornerRadius="18" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Panel.ZIndex="50">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="76" Height="76" CornerRadius="22" Background="#17152B" ClipToBounds="True"><Image Source="pack://application:,,,/LocaUltrator;component/Assets/LocaUltrator.png" Stretch="Uniform" Margin="7"/></Border><TextBlock Text="FELDOLGOZÁS" Foreground="#5BE7C4" FontSize="11" FontWeight="Bold" Margin="0,14,0,6"/><TextBlock Text="{Binding BusyMessage}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/><ProgressBar IsIndeterminate="True" Width="360" Margin="0,18,0,0"/><Button Content="Művelet megszakítása" Command="{Binding CancelBusyCommand}" Visibility="{Binding CanCancelBusy, Converter={StaticResource BoolVisibility}}" Margin="0,16,0,0" HorizontalAlignment="Center"/></StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
