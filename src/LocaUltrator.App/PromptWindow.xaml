<Window x:Class="LocaUltrator.App.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projekt-specifikus tokenvédelmi prompt" Width="940" Height="740"
        MinWidth="720" MinHeight="540" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="{StaticResource WindowGradient}" Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="FÁJLHOZ IGAZÍTOTT TOKENVÉDELEM" Style="{StaticResource SectionLabel}" Foreground="#5BE7C4"/>
            <TextBlock Text="Beépített AI-prompt és valódi projektadatok" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,4"/>
            <TextBlock Text="A három {{...}} helyőrzőt hagyd meg. Másoláskor a program behelyettesíti a projekt tokenjelöltjeit és a TXT-szerkezetet, majd a promptot a forrás-pillanatképek mellé is menti."
                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,15" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="10">
            <TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Alapértelmezett visszaállítása" Click="Reset"/>
                <Button Content="1. Prompt + TXT az AI-nak" Style="{StaticResource SuccessButton}" Click="CopyFilled"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Mégse" IsCancel="True"/>
                <Button Content="Sablon mentése" Style="{StaticResource PrimaryButton}" Click="Save" Margin="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
